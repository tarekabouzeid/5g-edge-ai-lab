# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env file (see .gitignore).
#
# Every image/chart tag below was the latest stable release as of 2026-09-13
# (verified via each registry's API, not guessed — see git log for the commit
# that last bumped them). Re-check before a new deployment with:
#   ./scripts/check-latest-versions.sh

# --- PLMN identity (3GPP reserved test PLMN; change only if you know why) ---
MCC=999
MNC=70

# --- Open5GS core network (docker bridge) ---
CORE_SUBNET=10.10.0.0/24
CORE_GATEWAY=10.10.0.1
OPEN5GS_IMAGE_TAG=2.8.0
DBCTL_IMAGE_TAG=0.10.3
MONGO_IMAGE_TAG=8.3.9

# Static addresses inside CORE_SUBNET (must stay consistent with core/config/*.yaml)
MONGO_IP=10.10.0.2
NRF_IP=10.10.0.10
SCP_IP=10.10.0.200
AUSF_IP=10.10.0.11
UDM_IP=10.10.0.12
PCF_IP=10.10.0.13
NSSF_IP=10.10.0.14
BSF_IP=10.10.0.15
UDR_IP=10.10.0.20
AMF_IP=10.10.0.5
SMF_IP=10.10.0.4
UPF_IP=10.10.0.7
WEBUI_IP=10.10.0.100
GNB_IP=10.10.0.50
UE_IP=10.10.0.51

# --- UERANSIM image ---
UERANSIM_IMAGE_TAG=3.3.0

# --- Test subscriber (Phase 1 DoD) ---
# Never reuse these values outside a lab. K/OPC below are the well-known
# 3GPP test vectors, not secrets, but treat any real subscriber's keys as one.
TEST_IMSI=999700000000001
TEST_KEY=465B5CE8B199B49FAA5F0A2EE238A6BC
TEST_OPC=E8ED289DEBA952E4283B54E88E6183CA
TEST_APN=internet

# --- Local breakout / edge DNN (Phase 3) ---
EDGE_APN=edge
EDGE_UE_SUBNET=10.47.0.0/16
INTERNET_APN=internet
INTERNET_UE_SUBNET=10.45.0.0/16

# --- Edge cluster: minikube (./lab.sh minikube up) ---
# Optional sizing for `minikube start`; empty = minikube's defaults.
MINIKUBE_CPUS=
MINIKUBE_MEMORY=

# Edge node IP for scripts/stream-test-video.sh; empty = `minikube ip`
# (usually 192.168.49.2). The lab portal and the breakout script look it up
# themselves.
EDGE_NODE_IP=

# --- Video ingestion / gateway ---
MEDIAMTX_IMAGE_TAG=1.21.0

# --- VLM serving ---
# Gemma 4 E4B-it (Google, Apache 2.0): ~4.5B effective params, served as
# ggml-org/gemma-4-E4B-it-GGUF:Q8_0 (~8 GB model + mmproj; fits a 16 GB GPU
# with room to spare). Step up to Gemma 4 12B-it for better answers to the
# portal's questions if you accept slower replies. The GGUF repo itself is
# hardcoded in edge/manifests/vlm-deployment.yaml; this name is only what
# edge-ingest sends as the request's "model" field (llama-server serving a
# single model ignores it).
VLM_MODEL=google/gemma-4-E4B-it
# Served by llama.cpp's CUDA server (GGUF build of the model) — vLLM hangs
# under WSL2's GPU passthrough, see docs/phase-notes/phase-6.md. The tag is
# hardcoded in edge/manifests/vlm-deployment.yaml (kubectl does no env
# substitution); this copy is what scripts/check-latest-versions.sh compares.
LLAMACPP_IMAGE_TAG=server-cuda-b11151
VLM_PORT=8000

# --- Monitoring ---
PROMETHEUS_IMAGE_TAG=v3.13.3
GRAFANA_IMAGE_TAG=13.0.8
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
