# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env file (see .gitignore).
#
# Every image/chart tag below was the latest stable release as of 2026-09-13
# (verified via each registry's API, not guessed — see git log for the commit
# that last bumped them). Re-check before a new deployment with:
#   ./scripts/check-latest-versions.sh

# --- PLMN identity (3GPP reserved test PLMN; change only if you know why) ---
MCC=999
MNC=70

# --- Open5GS core network (docker bridge) ---
CORE_SUBNET=10.10.0.0/24
CORE_GATEWAY=10.10.0.1
OPEN5GS_IMAGE_TAG=2.8.0
DBCTL_IMAGE_TAG=0.10.3
MONGO_IMAGE_TAG=8.3.9

# Static addresses inside CORE_SUBNET (must stay consistent with core/config/*.yaml)
MONGO_IP=10.10.0.2
NRF_IP=10.10.0.10
SCP_IP=10.10.0.200
AUSF_IP=10.10.0.11
UDM_IP=10.10.0.12
PCF_IP=10.10.0.13
NSSF_IP=10.10.0.14
BSF_IP=10.10.0.15
UDR_IP=10.10.0.20
AMF_IP=10.10.0.5
SMF_IP=10.10.0.4
UPF_IP=10.10.0.7
WEBUI_IP=10.10.0.100
GNB_IP=10.10.0.50
UE_IP=10.10.0.51

# --- UERANSIM image ---
UERANSIM_IMAGE_TAG=3.3.0

# --- Test subscriber (Phase 1 DoD) ---
# Never reuse these values outside a lab. K/OPC below are the well-known
# 3GPP test vectors, not secrets, but treat any real subscriber's keys as one.
TEST_IMSI=999700000000001
TEST_KEY=465B5CE8B199B49FAA5F0A2EE238A6BC
TEST_OPC=E8ED289DEBA952E4283B54E88E6183CA
TEST_APN=internet

# --- Local breakout / edge DNN (Phase 3) ---
EDGE_APN=edge
EDGE_UE_SUBNET=10.47.0.0/16
INTERNET_APN=internet
INTERNET_UE_SUBNET=10.45.0.0/16

# --- K3s / edge cluster ---
# Leave K3S_VERSION empty to install whatever K3s currently calls "stable"
# (recommended — always latest); set it to pin a specific version instead,
# e.g. v1.36.4+k3s1.
K3S_VERSION=
EDGE_NODE_IP=CHANGE_ME_TO_HOST_LAN_IP
GPU_OPERATOR_VERSION=v26.7.0
DCGM_EXPORTER_IMAGE_TAG=4.6.0-4.8.3-ubuntu22.04

# --- KIND (local dev/test path, no GPU required — see edge/kind/README.md) ---
KIND_CLUSTER_NAME=edge-ai-lab
KIND_NODE_IMAGE=kindest/node:v1.33.12

# --- Video ingestion / gateway ---
MEDIAMTX_IMAGE_TAG=1.21.0

# --- VLM serving ---
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
VLM_IMAGE_TAG=v0.29.0
VLM_PORT=8000

# --- Monitoring ---
PROMETHEUS_IMAGE_TAG=v3.13.3
GRAFANA_IMAGE_TAG=13.0.8
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
