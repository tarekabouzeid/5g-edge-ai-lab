# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env file (see .gitignore).

# --- PLMN identity (3GPP reserved test PLMN; change only if you know why) ---
MCC=999
MNC=70

# --- Open5GS core network (docker bridge) ---
CORE_SUBNET=10.10.0.0/24
CORE_GATEWAY=10.10.0.1
OPEN5GS_IMAGE_TAG=2.7.5

# Static addresses inside CORE_SUBNET (must stay consistent with core/config/*.yaml)
MONGO_IP=10.10.0.2
NRF_IP=10.10.0.10
SCP_IP=10.10.0.200
AUSF_IP=10.10.0.11
UDM_IP=10.10.0.12
PCF_IP=10.10.0.13
NSSF_IP=10.10.0.14
BSF_IP=10.10.0.15
UDR_IP=10.10.0.20
AMF_IP=10.10.0.5
SMF_IP=10.10.0.4
UPF_IP=10.10.0.7
WEBUI_IP=10.10.0.100
GNB_IP=10.10.0.50
UE_IP=10.10.0.51

# --- UERANSIM image ---
UERANSIM_IMAGE_TAG=3.2.7

# --- Test subscriber (Phase 1 DoD) ---
# Never reuse these values outside a lab. K/OPC below are the well-known
# 3GPP test vectors, not secrets, but treat any real subscriber's keys as one.
TEST_IMSI=999700000000001
TEST_KEY=465B5CE8B199B49FAA5F0A2EE238A6BC
TEST_OPC=E8ED289DEBA952E4283B54E88E6183CA
TEST_APN=internet

# --- Local breakout / edge DNN (Phase 3) ---
EDGE_APN=edge
EDGE_UE_SUBNET=10.47.0.0/16
INTERNET_APN=internet
INTERNET_UE_SUBNET=10.45.0.0/16

# --- K3s / edge cluster ---
K3S_VERSION=v1.30
EDGE_NODE_IP=CHANGE_ME_TO_HOST_LAN_IP

# --- VLM serving ---
VLM_MODEL=Qwen/Qwen2-VL-7B-Instruct
VLM_PORT=8000

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
